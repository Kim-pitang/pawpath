# PawPath (댕댕 산책각) 환경변수
# 모든 값은 선택 사항이며, 값을 비우거나 줄을 지우면 기본값으로 동작합니다.
# 이 파일을 저장소 최상위에 .env로 복사해 쓰세요. .env는 커밋하지 않습니다.

# 데이터베이스. PostgreSQL 사용 시 예: postgresql+psycopg://user:password@localhost:5432/pawpath
DATABASE_URL=sqlite:///./pawpath.db

# 날씨 제공자: open-meteo(실제 날씨, 키 불필요) 또는 mock(항상 모의 데이터)
WEATHER_PROVIDER=open-meteo
WEATHER_CACHE_MINUTES=30
WEATHER_TIMEOUT_SECONDS=5

# 출발점 길찾기, 복귀 경로, 이탈 시 재탐색에 쓰는 도보 길찾기: osrm 또는 none(직선 표시)
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://routing.openstreetmap.de/routed-foot
ROUTING_TIMEOUT_SECONDS=4
# 이 거리(km)보다 멀면 도보 안내 대신 외부 지도 앱을 안내합니다
ROUTING_MAX_DISTANCE_KM=3
# 산책길 자동 생성이 길찾기 서버를 부르는 방식. 기본값은 공용 서버(초당 1회 안내)에 맞춘 값입니다.
# 직접 띄운 OSRM을 쓰면 ROUTING_MIN_INTERVAL_SECONDS=0, GENERATION_COOLDOWN_SECONDS=0 으로 줄여도 됩니다.
ROUTING_MIN_INTERVAL_SECONDS=1.1
GENERATION_MAX_SECONDS=30
GENERATION_COOLDOWN_SECONDS=10
# 어떤 모양을 얼마나 시도할지. 아래 기본값은 공용 서버용(방위 8개, 요청 11회)입니다.
# 직접 띄운 OSRM이면 늘릴 수 있습니다. 예: GENERATION_BEARINGS=24, GENERATION_RADIUS_SCALES=1.0,0.8,
# GENERATION_MAX_REQUESTS=60, GENERATION_POOL_SIZE=30, GENERATION_MAX_SECONDS=60 (시도 수가 늘면 제한 시간도 함께 올리세요)
GENERATION_BEARINGS=8
GENERATION_RADIUS_SCALES=1.0
GENERATION_SPREADS=30
GENERATION_MAX_REQUESTS=11
GENERATION_POOL_SIZE=5
GENERATION_MAX_RESULTS=5

# 내 산책길을 추천 후보로 등록할 때 도로, 조명, 노면, 나무, 공원을 OpenStreetMap에서 측정: overpass 또는 none
# none이거나 측정에 실패하면 해당 항목은 "확인 불가"로 표시하고 안전하다고 보지 않습니다.
ENVIRONMENT_PROVIDER=overpass

# 추천 가중치 JSON. 비워 두면 기본값을 씁니다. 예: {"weather":0.3,"safety":0.2,"user_preference":0.15}
RECOMMENDER_WEIGHTS=

# 추천 이유 문장 생성: none(템플릿만) 또는 ollama. 꺼져 있거나 실패해도 추천은 그대로 동작합니다.
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4:e4b
LLM_TIMEOUT_SECONDS=60

# 서비스 지역: mangwon(서울 마포구 망원동, 코스 10개) 또는 gaepo(서울 강남구 개포동, 코스 6개)
SERVICE_AREA=mangwon
# 날씨를 조회할 좌표. 비워 두면 서비스 지역의 좌표를 씁니다.
SERVICE_LATITUDE=
SERVICE_LONGITUDE=
SERVICE_TIMEZONE=Asia/Seoul

# 프론트엔드 개발 서버 주소 (쉼표로 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 첫 실행 시 시연용 반려동물 '두부'를 함께 생성할지 여부
SEED_DEMO_PET=true

# 로그인 필수 여부. false면 로그인하지 않아도 시연 보호자로 쓸 수 있고, 로그인한 보호자의 데이터는 따로 관리됩니다.
AUTH_REQUIRED=false

# Google 로그인 (선택). Google Cloud 콘솔에서 만든 OAuth 클라이언트(웹 애플리케이션)의 값을 넣으면 로그인 화면에 Google 버튼이 생깁니다.
# 비밀값은 이 파일이 아니라 .env에만 넣고 커밋하지 마세요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 콘솔의 "승인된 리디렉션 URI"와 똑같아야 하고, 앱도 이 주소의 호스트(localhost)로 열어야 합니다.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# 자동 백업. SQLite일 때 서버가 스스로 돌립니다. 정책과 복구 방법은 docs/BACKUP.md를 보세요.
BACKUP_ENABLED=true
# DB 사본과 탈퇴 기록이 들어갑니다. 디스크 장애에 대비하려면 DB와 다른 디스크를 지정하세요.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
# 이 기간이 지난 백업을 지웁니다. 탈퇴한 보호자의 데이터가 백업에 남는 최대 기간이기도 합니다.
BACKUP_RETENTION_DAYS=14
